# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database (Supabase PostgreSQL) ──────────────────────────────
# Transaction Pooler URL: Supabase → Project Settings → Database → Connection string
DATABASE_URL=             # postgresql://postgres.aaefpvrsqgakdkryhpdj:[password]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# ── Supabase (server-side) ───────────────────────────────────────
SUPABASE_URL=https://aaefpvrsqgakdkryhpdj.supabase.co
SUPABASE_ANON_KEY=        # anon key from Supabase → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY= # service role key (keep secret — server only)

# ── Supabase (client-side, exposed via Vite) ─────────────────────
VITE_SUPABASE_URL=https://aaefpvrsqgakdkryhpdj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6dj3VSiFPcdQF6EWe4UTvg_tIn8euEn

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── QuickKickBot (@Quickkickbot) ────────────────────────────────
TELEGRAM_BOT_TOKEN=          # Bot token from @BotFather
TELEGRAM_CHAT_ID=            # Your chat ID (send /start to @userinfobot)

# ── LadyJayeBot ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN_LADYJAYE= # Bot token for LadyJayeBot from @BotFather
TELEGRAM_CHAT_ID_LADYJAYE=   # Chat ID for LadyJaye alerts

# ── Bot Intelligence APIs ────────────────────────────────────────
BRAVE_API_KEY=               # Brave Search API key (brave.com/search/api) — used by QuickKickBot for lead research
ANTHROPIC_API_KEY=           # Claude API key — used by LadyJayeBot for message generation

# ── Twilio (calling + SMS) ─────────────────────────────────────────
# Twilio Console → Account Info for SID; API keys under Settings → API Keys.
TWILIO_ACCOUNT_SID=          # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=              # SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=           # API key secret (keep secret — server only)
TWILIO_AUTH_TOKEN=           # Account auth token (used as fallback)
TWILIO_PHONE_NUMBER=         # Outbound caller ID, e.g. +14135551234

# ── Webhook Registration ─────────────────────────────────────────
APP_URL=                     # Your public domain (e.g. https://maya-agent.up.railway.app) — auto-registers Telegram webhooks on boot

